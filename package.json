{
  "name": "hayalet-mentor",
  "version": "2.0.0",
  "description": "Hayalet Mentor - Tarihi figurlerle etkilesimli sohbet sistemi (Gemini API tabanli)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"node server.js\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "server": "node server.js",
    "client": "npm run dev --prefix client"
  },
  "dependencies": {
    "@google/generative-ai": "^0.11.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
